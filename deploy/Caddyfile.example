# Reverse proxy in front of the API. Hashed assets are served straight from disk, pre-compressed.
llmers.es {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	request_body {
		max_size 1MB
	}
	@assets path /assets/*
	handle @assets {
		root * /opt/dailyclips/prod/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8821
	}
}

www.llmers.es {
	redir https://llmers.es{uri} permanent
}
